# Secrets stay out of the repo and out of the agent's context.
# (The server-side embedding key lives here in dev; viewers' BYOK LLM keys live
#  in the browser, never in the repo. See CLAUDE.md.)
.env
.env.*
!.env.example

# ── Python pipeline — uv / ruff / mypy / pytest (ADR 0006) ───────────────────
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Next.js front end — pnpm / Next / Vitest (ADR 0006) ──────────────────────
node_modules/
.next/
out/
build/
coverage/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
